```gitignore
# Secrets and credentials
.env
.env.*
!.env.example
auth.json
*secret*.json
*credentials*.json
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Private backups and archives
*.age
*.enc
*.tar
*.tar.gz
*.zip
*.bak

# Private application data
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
state.db*
projects.db*
kanban.db*
shared-state.db*
data.sqlite*
sessions/
memories/
pending_messages/
logs/

# Local configuration
config.yaml
config.yml

# Temporary files
*.tmp
*.log
.DS_Store
Thumbs.db

# Runtime files
*.sock
*.pid
*.lock
__pycache__/
node_modules/

# Local editor and environment files
.vscode/
.idea/
.envrc

# Backup working directory
backup-hermes/
```
